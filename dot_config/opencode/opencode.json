{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
    "cocoindex-code": {
      "type": "local",
      "command": [
        "ccc", "mcp"
      ]
    }
  ,
        "obsidian": {
            "type": "local",
		"enabled": false,
            "command": [
                "npx",
                "-y",
                "@mauricio.wolff/mcp-obsidian@latest",
                "~/Documents/Obsidian-PKMS"
            ]
        }
    },
    "provider": {
	        "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
	"smollm2:1.7b": {"name": "smollm2", "stream": false},
	"phi4-mini:latest": {"name": "phi4-mini", "stream": false},
 
      },
    },
        "omniroute": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "OmniRoute",
            "options": {
                "baseURL": "http://192.168.3.154:20128/v1",
                "apiMode": "chat",
		"modelMetadata": [
  {  
    "match": "All-Models-Combo", 
    "contextWindow": 128000,  
    "maxTokens": 4096,
    "supportsTools": true,
    "reasoning": true,
    "supportsVision": false
  }]
            }
        }
    },
  "formatter": true,
    "plugin": [
        "oh-my-openagent@latest",
        "@cedrugs/opencode-omniauth"
    ],
"lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"]
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py"]
    },
    "pyright": {
      "disabled": true
    }
  }
}
