{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
    "cocoindex-code": {
      "type": "local",
      "command": [
        "ccc", "mcp"
      ]
    },
    "deepwiki": {
	"type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    }
  ,
    },
    "provider": {
	        "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
	"smollm2:1.7b": {"name": "smollm2", "stream": false},
	"phi4-mini:latest": {"name": "phi4-mini", "stream": false},
 
      },
    },
        "omniroute": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "OmniRoute",
            "options": {
                "baseURL": "http://192.168.3.154:20128/v1",
                "apiMode": "chat",
            }
        }
    },
  "formatter": true,
"lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"]
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py"]
    },
    "pyright": {
      "disabled": true
    }
  }
}
