{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cocoindex-code": {
      "type": "local",
      "command": [
        "ccc",
        "mcp"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "smollm2:1.7b": {
          "name": "smollm2",
          "stream": false
        },
        "phi4-mini:latest": {
          "name": "phi4-mini",
          "stream": false
        }
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "https://omniroute.jetson/v1",
        "apiMode": "chat"
      },
      "models": {
        "main": {
          "name": "main",
          "limit": {
            "context": 1000000,
            "output": 65000
          }
        },
        "auto": {
          "name": "auto",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        }
      }
    },
    "cliproxyapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLI Proxy API",
      "options": {
        "baseURL": "https://cliproxyapi.jetson/v1",
      },
      "models": {
        "claude-sonnet-4-6": {},
        "claude-opus-4-6-thinking": {},
        "grok-4.3": {},
        "grok-3-mini-fast": {},
        "gemini-2.5-flash-lite": {},
        "gemini-2.5-flash": {},
        "gemini-3.1-pro-preview": {},
        "gemini-3-pro-preview": {},
        "gemini-3-flash-preview": {},
        "gemini-3.1-flash-lite-preview": {},
        "gpt-5.5": {},
        "gpt-5.3-codex": {},
        "gpt-5.4": {},
        "codex-auto-review": {},
        "gpt-5.2": {},
        "gpt-5.4-mini": {}
      }
    }
  },
  "formatter": true,
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-pty",
    "opencode-skills",
    "opencode-vibeguard",
    "opencode-background-agents",
    "@mailshieldai/opencode-canvas",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "lsp": {
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "pyright": {
      "disabled": true
    }
  },
  "disabled_providers": []
}
