{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cocoindex-code": {
      "type": "local",
      "command": [
        "ccc",
        "mcp"
      ]
    },
    "obsidian": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "@mauricio.wolff/mcp-obsidian@latest",
        "~/Documents/Obsidian-PKMS"
      ]
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "smollm2:1.7b": {"name": "smollm2", "stream": false},
        "phi4-mini:latest": {"name": "phi4-mini", "stream": false}
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "https://omniroute.jetson",
        "apiMode": "chat"
      },
      "models": {
        "ag": {
          "name": "antigravity",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "gemini": {
          "name": "gem"
        }
      }
    }
  }
