{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
  "categories": {
    "quick": {
      "model": "ollama/smollm2:1.7b",
    },
    "writing": {
      "model": "omniroute/All-Models-Combo"
    },
    "unspecified-low": {
      "model": "omniroute/All-Models-Combo"
    },
    "unspecified-high": {
      "model": "omniroute/All-Models-Combo"
    },
    "deep": {
      "model": "omniroute/All-Models-Combo"
    },
    "ultrabrain": {
      "model": "omniroute/All-Models-Combo"
    },
    "visual-engineering": {
      "model": "omniroute/All-Models-Combo"
    }
  },
  "agents": {
    "sisyphus": {
      "model": "omniroute/All-Models-Combo",
      "ultrawork": {
        "model": "omniroute/All-Models-Combo"
      },
      "prompt_append": "Delegate heavily to hephaestus for implementation. Parallelize exploration."
    },
    "prometheus": {
      "model": "omniroute/All-Models-Combo",
      "prompt_append": "Keep plans concise. Focus on file structure and key decisions."
    },
    "metis": {
      "model": "omniroute/All-Models-Combo"
    },
    "oracle": {
      "model": "omniroute/All-Models-Combo",
      "variant": "high"
    },
    "hephaestus": {
      "model": "omniroute/All-Models-Combo",
      "prompt_append": "You are the primary implementation agent. Own the codebase. Explore, decide, execute. Use LSP and AST-grep aggressively.",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "atlas": {
      "model": "omniroute/All-Models-Combo"
    },
    "explore": {
      "model": "ollama/phi4-mini:latest",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      },
      "temperature": 0.1
    },
    "librarian": {
      "model": "ollama/phi4-mini:latest",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "temperature": 0.1
    },
    "momus": {
      "model": "omniroute/All-Models-Combo",
      "prompt_append": "Focus on code quality, edge cases, and test coverage.",
      "variant": "xhigh"
    },
    "multimodal-looker": {
      "model": "omniroute/All-Models-Combo"
    },
    "sisyphus-junior": {
      "model": "omniroute/All-Models-Combo"
    }
  },
  "background_task": {
    "defaultConcurrency": 2,
    "providerConcurrency": {
      "omniroute": 10
    },
    "modelConcurrency": {
      "omniroute/All-Models-Combo": 4
    }
  },
  "hashline_edit": true,
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true
  },
  "disabled_mcps": [],
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}
