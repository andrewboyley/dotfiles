# ~/.zshrc — managed by chezmoi
# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================================
# OS-SPECIFIC CONFIG
# ============================================================================

{{ if eq .chezmoi.osRelease.id "cachyos" -}}
source /usr/share/cachyos-zsh-config/cachyos-config.zsh
{{ end -}}

# ============================================================================
# CONDA / MAMBA (shell-guarded)
# ============================================================================

# >>> conda initialize >>>
if [ -x '/home/andrew/miniforge3/bin/conda' ]; then
    __conda_setup="$('/home/andrew/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "/home/andrew/miniforge3/etc/profile.d/conda.sh" ]; then
            . "/home/andrew/miniforge3/etc/profile.d/conda.sh"
        else
            export PATH="/home/andrew/miniforge3/bin:$PATH"
        fi
    fi
    unset __conda_setup
fi

# >>> mamba initialize >>>
if [ -x '/home/andrew/miniforge3/bin/mamba' ]; then
    export MAMBA_EXE='/home/andrew/miniforge3/bin/mamba';
    {{ if eq .chezmoi.osRelease.id "cachyos" -}}
    export MAMBA_ROOT_PREFIX='/home/andrew/.local/share/mamba';
    {{ else -}}
    export MAMBA_ROOT_PREFIX='/home/andrew/miniforge3';
    {{ end -}}
    __mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__mamba_setup"
    else
        alias mamba="$MAMBA_EXE"
    fi
    unset __mamba_setup
fi

# ============================================================================
# UNIVERSAL TOOL PATHS
# ============================================================================

[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"
[ -d "$HOME/.npm-global/bin" ] && export PATH="$HOME/.npm-global/bin:$PATH"
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"

# ============================================================================
# THEME / PROMPT
# ============================================================================

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
